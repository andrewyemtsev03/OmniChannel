# --- Server ---
PORT=4000
NODE_ENV=development
# Public address doctors open links on (used to build tracked links)
PUBLIC_BASE_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgres://stada:stada@localhost:5432/stada_omni

# --- Security ---
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# First admin account (created on first start if no users exist)
ADMIN_EMAIL=admin@stada.kz
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin

# --- Uploaded presentations ---
UPLOAD_DIR=./uploads

# --- Viewer ---
# Show "for healthcare professionals only" confirmation before a deck opens
HCP_GATE=true

# --- WhatsApp Business Platform (Cloud API) ---
# Leave WHATSAPP_TOKEN empty to run in dry-run mode: nothing is sent,
# and reps get a wa.me click-to-chat link with the tracked URL instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Approved template with 3 body variables: {{1}} doctor name, {{2}} presentation title, {{3}} link
WHATSAPP_TEMPLATE_NAME=presentation_share
WHATSAPP_TEMPLATE_LANG=ru
